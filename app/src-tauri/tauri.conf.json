{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omebly Downloader",
  "version": "0.2.3",
  "identifier": "com.omebly.downloader",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Omebly Downloader",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": true,
        "backgroundColor": "#081110"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "Omebly",
    "copyright": "GPL-3.0-or-later",
    "category": "Utility",
    "shortDescription": "Download videos, audio, images and files at full speed",
    "resources": {
      "tools/yt-dlp.exe": "tools/yt-dlp.exe"
    },
    "licenseFile": "../AGREEMENT.txt",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
