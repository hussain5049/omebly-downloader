{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omebly Downloader",
  "version": "0.3.2",
  "identifier": "com.omebly.downloader",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Omebly Downloader",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": true,
        "backgroundColor": "#081110"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "Omebly",
    "copyright": "GPL-3.0-or-later",
    "category": "Utility",
    "shortDescription": "Download videos, audio, images and files at full speed",
    "resources": {
      "tools/yt-dlp.exe": "tools/yt-dlp.exe",
      "tools/ffmpeg.exe": "tools/ffmpeg.exe",
      "tools/FFMPEG-LICENSE.txt": "tools/FFMPEG-LICENSE.txt",
      "../../extension/": "extension/"
    },
    "licenseFile": "../AGREEMENT.txt",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBMzZBQTg0QURGQzNGM0IKUldRN1AveXRoS28yV2kvYklPaXN2NjZ3ZTFkV1dJVjB3ZEhxUnNkc3JKbEJyRElWV3BXN0hWL3UK",
      "endpoints": [
        "https://api.omebly.com/downloads/downloader/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
